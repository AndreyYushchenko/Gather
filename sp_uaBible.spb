B016C007V052	16	7	52	сини Бесаєві, сини Меунімові, сини Нефішесінові,
B016C007V053	16	7	53	сини Бакбутові, сини Хакуфині, сини Хархурові,
B016C007V054	16	7	54	сини Бацлітові, сини Мехидині, сини Харшині,
